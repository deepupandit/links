def get_iceberg_metrics(spark, table_identifier):
    # Get the latest snapshot ID
    latest_snapshot = spark.sql(f"SELECT snapshot_id FROM {table_identifier}.snapshots ORDER BY committed_at DESC LIMIT 1").collect()[0][0]
    
    # Query the manifests to get accurate metrics
    metrics = spark.sql(f"""
    SELECT 
        operation,
        SUM(added_files_count) as added_files,
        SUM(existing_files_count) as existing_files,
        SUM(deleted_files_count) as deleted_files,
        SUM(added_rows_count) as added_rows,
        SUM(existing_rows_count) as existing_rows,
        SUM(deleted_rows_count) as deleted_rows
    FROM {table_identifier}.manifests
    WHERE snapshot_id = {latest_snapshot}
    GROUP BY operation
    """).collect()
    
    return metrics

def perform_merge_operation(source_df, target_identifier):
    try:
        # Create temporary view
        source_df.createOrReplaceTempView("__temp_silver_updates")
        
        # Execute merge
        merge_query = self._generate_merge_query(target_identifier)
        etl.session.pro_iceberg.execute_query(merge_query)
        
        # Get Iceberg metrics
        metrics = get_iceberg_metrics(etl.session.pro_iceberg, target_identifier)
        
        for m in metrics:
            if m['operation'] == 'append':
                inserted_count = m['added_rows']
            elif m['operation'] == 'overwrite':
                updated_count = m['added_rows']
        
        print(f"Merge completed: {inserted_count} records inserted, {updated_count} records updated")
        
        return True, f"Inserted: {inserted_count}, Updated: {updated_count}"
    except Exception as e:
        return False, f"Merge failed: {str(e)}"
    finally:
        etl.session.pro_iceberg.execute_query("DROP VIEW IF EXISTS __temp_silver_updates")




